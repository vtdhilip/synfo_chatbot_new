{
  "compilerOptions": {
    "composite": true,        // Required when this tsconfig is referenced by another tsconfig
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo", // Updated path for build info file
    "target": "ES2023",       // Updated target to ES2023
    "lib": ["ES2023"],        // Updated lib to ES2023
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,      // Added
    "moduleDetection": "force",        // Added
    "noEmit": true,           // Changed from false to true to satisfy 'allowImportingTsExtensions'

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,        // Added
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true // Added
  },
  "include": [
    "vite.config.ts"          // Updated to only include vite.config.ts
  ]
}
